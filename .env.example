# WAVE AI — environment variables.
# Copy this file to .env for local development, or set the variables
# in your hosting dashboard (Render > Environment). Never commit real
# secrets to git.

# REQUIRED in production. A long random string used to sign login sessions.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Email of the owner account. That account can open /admin.
# Sign up in the app with this exact email after deploying.
ADMIN_EMAIL=owner@example.com

# Free AI provider (Pollinations, no key needed). Change only if you switch
# to another OpenAI-compatible API.
AI_BASE_URL=https://text.pollinations.ai/openai
AI_MODEL=openai-fast

# Pricing / limits (defaults — the owner can also change these in /admin).
PRO_PRICE_PHP=149
FREE_DAILY_LIMIT=20

# GCash details shown on the pricing page (also editable in /admin).
GCASH_NUMBER=
GCASH_NAME=

# Optional: a Stripe Payment Link (https://buy.stripe.com/...) for card
# payments. Leave blank to hide the card button entirely.
STRIPE_PAYMENT_LINK=

# Server port (Render sets PORT automatically).
PORT=3000
NODE_ENV=production
