# WAVE AI — environment variables (Cloudflare Workers version).
# Local dev: copy the values into `.dev.vars` (gitignored) and run
# `npm run dev`. Production: set them in the Cloudflare dashboard
# (Workers & Pages > wave-ai > Settings > Variables and Secrets).
# Never commit real secrets to git.

# REQUIRED. A long random string used to sign login sessions.
# Generate one:  openssl rand -hex 32
# Local: put it in .dev.vars. Production: wrangler secret put SESSION_SECRET
SESSION_SECRET=

# Email of the owner account. That account can open /admin.
# Sign up in the app with this exact email after deploying.
# Production: wrangler secret put ADMIN_EMAIL
ADMIN_EMAIL=owner@example.com

# Free AI provider (Pollinations, no key needed). Change only if you switch
# to another OpenAI-compatible API. Also set as [vars] in wrangler.toml.
AI_BASE_URL=https://text.pollinations.ai/openai
AI_MODEL=openai-fast

# Pricing / limits (defaults — the owner can also change these in /admin).
PRO_PRICE_PHP=149
FREE_DAILY_LIMIT=20

# GCash details shown on the pricing page (also editable in /admin).
GCASH_NUMBER=
GCASH_NAME=

# Optional: a Stripe Payment Link (https://buy.stripe.com/...) for card
# payments. Leave blank to hide the card button entirely.
STRIPE_PAYMENT_LINK=
